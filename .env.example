# Never commit the real key. In Intervals.icu: Settings > Developer Settings.
INTERVALS_API_KEY=replace_me

# Local test only. Production refuses to start without Auth0 unless this is true.
AUTH_MODE=none
ALLOW_INSECURE_NOAUTH=false

# Render / production with Auth0:
# AUTH_MODE=auth0
# MCP_RESOURCE_URL=https://your-service.onrender.com
# AUTH0_ISSUER=https://your-tenant.jp.auth0.com/
# AUTH0_ALLOWED_SUB=auth0|your_user_id

PORT=3000
HOST=127.0.0.1
MAX_RANGE_DAYS=120
INTERVALS_TIMEOUT_MS=15000
